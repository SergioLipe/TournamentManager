# ---------------------------------------------------------------------------
# Protecção dos ficheiros que não são páginas.
#
# Num alojamento partilhado como o InfinityFree o projecto inteiro fica dentro
# de htdocs/, ou seja, tudo é acessível pela web por omissão — incluindo o
# .env com a password da base de dados e os .sql da pasta database/.
#
# Só se usam directivas do core do Apache: nada de php_flag/php_value, que
# rebentam com 500 quando o PHP corre como CGI/FastCGI.
# ---------------------------------------------------------------------------

# --- Forçar HTTPS ------------------------------------------------------------
#
# Sem isto o site respondia normalmente em http://, incluindo o login — a
# sessão nascia sem a flag Secure na cookie e ficava visível a quem
# partilhasse a rede. O InfinityFree está atrás de um proxy que nunca entrega
# HTTPS directo ao Apache, por isso o %{HTTPS} do mod_rewrite não chega a ver
# a ligação real; o cabeçalho X-Forwarded-Proto, esse, é fiável aqui.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Ficheiros escondidos (.env, .git, .htpasswd, ...) ---------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Extensões que nunca devem ser servidas --------------------------------
<FilesMatch "\.(?i:env|sql|md|log|ini|json|lock|example|bak|old|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Pastas que só existem para serem incluídas ----------------------------
# O includes/ e o database/ nunca são pedidos directamente pelo browser: as
# páginas incluem-nos por caminho de ficheiro, não por URL.
RedirectMatch 404 ^/(includes|database|vendor)(/|$)

# --- Não listar o conteúdo das pastas --------------------------------------
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# --- Instalação como aplicação ----------------------------------------------
#
# O manifest chama-se manifest.webmanifest e não manifest.json porque a regra
# das extensões acima nega tudo o que acabe em .json. O Apache não conhece
# esta extensão de origem e serviria o ficheiro como binário.
#
# O sw.js tem de estar na raiz para o service worker poder controlar o site
# todo, e nunca deve ser servido de cache: com uma versão velha agarrada, uma
# publicação nova pode nunca chegar a quem tem a app instalada.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
</Files>

# --- Cabeçalhos de segurança -----------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Página inicial ---------------------------------------------------------
DirectoryIndex index.php
